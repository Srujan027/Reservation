	<SourceCode>
		<Methods xmlns="">
			<Method>
				<Name>classDeclaration</Name>
				<Source><![CDATA[
/// <summary>
/// Setup dialog per FDD section 6.5 (Figure 2): five maintainable tabs bound
/// directly to the setup tables. Each grid row is saved through its own
/// datasource transaction as usual; there is no dialog-wide transaction, since
/// holding a ttsbegin open across an interactive modal session causes the
/// kernel to reject the unbalanced TTS as soon as the dialog is closed by any
/// path other than the Save/Cancel buttons (X button, Esc, a mid-edit error).
/// </summary>
[Form]
public class ResSetupDialog extends FormRun
{
}
]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>ResDeliveryPolicy</Name>
				<Methods>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret = super();

            // Minimum Fill Percentage only means anything once partial
            // delivery is allowed at all -- keep it locked otherwise so it
            // cannot be edited into a value the engine would never consult.
            DeliveryPolicyGrid_MinFillPercentage.enabled(ResDeliveryPolicy.AllowPartialDelivery == NoYes::Yes);

            return ret;
        }

]]></Source>
					</Method>
				</Methods>
				<Fields />
			</DataSource>
			<DataSource>
				<Name>ResOrderTypePolicy</Name>
				<Methods>
					<Method>
						<Name>active</Name>
						<Source><![CDATA[
        public int active()
        {
            int ret = super();

            // Same reasoning as ResDeliveryPolicy.active() -- lock the
            // transfer minimum fill field whenever transfer partial
            // delivery is not allowed.
            OrderTypePolicyGroup_TransferMinFillPercentage.enabled(ResOrderTypePolicy.TransferAllowPartial == NoYes::Yes);

            return ret;
        }

]]></Source>
					</Method>
				</Methods>
				<Fields />
			</DataSource>
