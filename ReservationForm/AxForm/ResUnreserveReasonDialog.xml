							<Name>clicked</Name>
							<Source><![CDATA[
        public void clicked()
        {
            super();

            if (!ReasonGroup_ReasonCode.text() || !ResReasonCode::exist(ReasonGroup_ReasonCode.text()))
            {
                warning("@ResReservation:ResUnreserveReasonDialog_ReasonRequired");
                return;
            }

            element.args().parmObject(new ContainerClass([ReasonGroup_ReasonCode.text(), CommentField.text()]));
            element.closeOk();
        }

]]></Source>
