					<Methods>
						<Method>
							<Name>lookup</Name>
							<Source><![CDATA[
        /// <summary>
        /// This field is unbound (no live ResReasonCode datasource on this
        /// dialog -- there is nothing here for a user to edit the catalog
        /// through, only to pick a code from it), so it needs its own lookup
        /// rather than relying on an EDT-level relation.
        /// </summary>
        public void lookup()
        {
            Query                query;
            QueryBuildDataSource qbds;
            SysTableLookup       sysTableLookup = SysTableLookup::newParameters(tableNum(ResReasonCode), this);

            sysTableLookup.addLookupfield(fieldNum(ResReasonCode, ReasonCode));
            sysTableLookup.addLookupfield(fieldNum(ResReasonCode, Description));

            query = new Query();
            qbds  = query.addDataSource(tableNum(ResReasonCode));

            sysTableLookup.parmQuery(query);
            sysTableLookup.performFormLookup();
        }

]]></Source>
						</Method>
					</Methods>
