		<Methods>
			<Method>
				<Name>consumedForSupplyRef</Name>
				<Source><![CDATA[
    /// <summary>
    /// Net quantity already consumed against one exact supply record (a
    /// PurchLine/ProdTable/InventTransferLine RecId), across every demand
    /// line that has ever drawn from it -- sum of logged Reserve qty minus
    /// sum of logged Unreserve qty for that supply reference.
    /// </summary>
    /// <remarks>
    /// This is the authoritative source for netting Purchase/Production/
    /// TransferInTransit availability in <c>ResSupplyProvider</c>, in place of
    /// inferring it from <c>InventTrans.InventDimId</c>: the standard WHS
    /// reservation hierarchy is not guaranteed to land an ordered reservation
    /// on the exact dimension it was offered (it can resolve to a different
    /// concrete batch/bin satisfying the same relaxed criteria), so querying
    /// by dimension can both miss the real reservation and, worse, misattribute
    /// it to an unrelated receipt line that happens to share that dimension.
    /// Our own audit trail has no such ambiguity: <c>commitReservation</c> and
    /// <c>unreserveLine</c> record the exact supply RecId they acted on.
    /// </remarks>
    public static Qty consumedForSupplyRef(RefTableId _supplyRefTableId, RefRecId _supplyRefRecId)
    {
        ResHistoryLog   historyLog;
        Qty             reserved;
        Qty             released;

        if (!_supplyRefRecId)
        {
            return 0;
        }

        select sum(QtyAffected) from historyLog
            where historyLog.SupplyRefTableId == _supplyRefTableId
            &&    historyLog.SupplyRefRecId   == _supplyRefRecId
            &&    historyLog.Action           == ResAction::Reserve;
        reserved = historyLog.QtyAffected;

        select sum(QtyAffected) from historyLog
            where historyLog.SupplyRefTableId == _supplyRefTableId
            &&    historyLog.SupplyRefRecId   == _supplyRefRecId
            &&    historyLog.Action           == ResAction::Unreserve;
        released = historyLog.QtyAffected;

        return reserved - released;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>
