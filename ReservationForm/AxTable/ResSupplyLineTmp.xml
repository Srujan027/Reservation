		<Methods>
			<Method>
				<Name>availableForReservation</Name>
				<Source><![CDATA[
    /// <summary>
    /// Not used by the form grid -- see the <c>AvailableForReservation</c>
    /// field instead. A `display` method on an InMemory table is unsafe for a
    /// grid column: the AX kernel caches display-method results keyed by
    /// (TableId, RecId), but an InMemory temp table's RecId sequence restarts
    /// from 1 on every fresh repopulation, so a stale cached value from an
    /// earlier, unrelated row can silently leak onto a different row that
    /// happens to land on the same RecId later -- a cache that survives even
    /// closing and reopening the form. Kept here only as a plain callable
    /// helper for other server-side code, not bound to any control.
    /// </summary>
    public Qty availableForReservation()
    {
        return this.AvailableForReservation - this.QtyReserved;
    }

]]></Source>
			</Method>
		</Methods>
