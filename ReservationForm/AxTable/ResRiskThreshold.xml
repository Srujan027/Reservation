				<Name>find</Name>
				<Source><![CDATA[
    public static ResRiskThreshold find(boolean _forUpdate = false)
    {
        ResRiskThreshold riskThreshold;

        if (_forUpdate)
        {
            riskThreshold.selectForUpdate(_forUpdate);
        }

        select firstonly riskThreshold;

        return riskThreshold;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();

        // riskIndicator() checks RedThresholdDays first, then YellowThresholdDays,
        // so Red must be the smaller (more urgent) day count for the Yellow tier
        // to ever be reachable -- e.g. Red=2 days, Yellow=7 days.
        if (this.RedThresholdDays > this.YellowThresholdDays)
        {
            ret = checkFailed("@ResReservation:ResRiskThreshold_OrderInvalid");
        }

        return ret;
    }

]]></Source>
			</Method>
