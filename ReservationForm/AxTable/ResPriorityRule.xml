{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();

        if (!this.CustAccount && !this.CustGroup)
        {
            ret = checkFailed("@ResReservation:ResPriorityRule_ScopeRequired");
        }

        if (this.PriorityTier < 1 || this.PriorityTier > 5)
        {
            ret = ret && checkFailed("@ResReservation:ResPriorityRule_TierRange");
        }

        if (this.EffectiveTo && this.EffectiveFrom && this.EffectiveTo < this.EffectiveFrom)
        {
            ret = ret && checkFailed("@ResReservation:ResPriorityRule_DateRange");
        }

        if (ret && this.hasOverlappingRule())
        {
            ret = checkFailed("@ResReservation:ResPriorityRule_OverlappingRule");
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>hasOverlappingRule</Name>
				<Source><![CDATA[
    /// <summary>
    /// True if another row already covers the same scope (CustAccount, or
    /// CustGroup when CustAccount is blank) with an overlapping effective
    /// date range. A blank EffectiveFrom/EffectiveTo is treated as open-ended
    /// on that side.
    /// </summary>
    private boolean hasOverlappingRule()
    {
        ResPriorityRule other;

        select firstonly RecId from other
            where other.CustAccount == this.CustAccount
            &&    other.CustGroup   == this.CustGroup
            &&    other.RecId       != this.RecId
            &&   (!this.EffectiveFrom || !other.EffectiveTo   || other.EffectiveTo   >= this.EffectiveFrom)
            &&   (!this.EffectiveTo   || !other.EffectiveFrom || other.EffectiveFrom <= this.EffectiveTo);

        return other.RecId != 0;
    }

]]></Source>
			</Method>
		</Methods>
