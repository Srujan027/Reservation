		<Methods>
			<Method>
				<Name>initValue</Name>
				<Source><![CDATA[
    public void initValue()
    {
        super();

        // Preserves the previous hardcoded behavior (mixing batches was always
        // allowed for Transfer demand) as the default for newly-created rows.
        // NOTE: this does not touch the existing singleton row in an
        // already-deployed environment -- an admin must open Setup and confirm
        // this toggle once after upgrading, since the new column otherwise
        // defaults to No on that pre-existing row.
        this.TransferAllowMixedBatch = NoYes::Yes;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static ResOrderTypePolicy find(boolean _forUpdate = false)
    {
        ResOrderTypePolicy orderTypePolicy;

        if (_forUpdate)
        {
            orderTypePolicy.selectForUpdate(_forUpdate);
        }

        select firstonly orderTypePolicy;

        return orderTypePolicy;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();

        if (this.TransferMinFillPercentage < 0 || this.TransferMinFillPercentage > 100)
        {
            ret = checkFailed("@ResReservation:ResOrderTypePolicy_FillRange");
        }

        return ret;
    }

]]></Source>
			</Method>
