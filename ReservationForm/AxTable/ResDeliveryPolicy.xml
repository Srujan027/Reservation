		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret = super();

        if (!this.CustAccount && !this.CustGroup)
        {
            ret = checkFailed("@ResReservation:ResDeliveryPolicy_ScopeRequired");
        }

        if (this.MinFillPercentage < 0 || this.MinFillPercentage > 100)
        {
            ret = ret && checkFailed("@ResReservation:ResDeliveryPolicy_FillRange");
        }

        return ret;
    }

]]></Source>
